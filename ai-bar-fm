#!/usr/bin/env bash
# ai-bar-fm: file manager a pannello singolo, senza librerie TUI esterne.
# Richiede Bash >= 4 (array associativi), stty e i comandi GNU di base.
set -u

usage() {
    cat <<'HELP'
Uso: ai-bar-fm [DIRECTORY]

File manager TUI a pannello singolo (Bash, senza ncurses).

 Frecce Su/Giu                   seleziona la riga (stile Lynx)
 Freccia Destra / Invio           apre dir o avvia file eseguibile
 Freccia Sinistra / Backspace     torna alla directory padre
 PgUp / PgDn / Home / End         navigazione veloce
 F3 (oppure Spazio)              seleziona/deseleziona
 F4                               copia negli appunti interni
 F5                               taglia negli appunti interni
 F6                               incolla nella directory corrente
 F7                               crea una directory
 F8                               cancella (chiede conferma)
 Ctrl+X poi C                     chmod: cambia permessi (ottale)
 Ctrl+X poi O                     chown: cambia proprietario[:gruppo]
 Ctrl+X poi S                     crea link simbolico all'elemento
 Mouse click                      seleziona / doppio click apre
 Rotella mouse                    scorre l'elenco
 r                                aggiorna la lista
 q                                esci

Opzioni d'ambiente:
 ABFM_NO_ALT_SCREEN=1             non usare lo schermo alternativo
 ABFM_NO_COLOR=1                  disabilita i colori ANSI
 ABFM_ASCII=1                     forza cornici ASCII al posto del box drawing
HELP
}

if [[ ${1:-} == --help || ${1:-} == -h ]]; then
    usage
    exit 0
fi
if (( $# > 1 )); then
    usage >&2
    exit 2
fi
if [[ ! -t 0 || ! -t 1 || ! -r /dev/tty ]]; then
    printf 'ai-bar-fm: eseguire in un terminale interattivo.\n' >&2
    exit 1
fi
if ! command -v stty >/dev/null 2>&1; then
    printf 'ai-bar-fm: stty non disponibile.\n' >&2
    exit 1
fi
if ! cwd=$(cd -P -- "${1:-.}" 2>/dev/null && pwd -P); then
    printf 'ai-bar-fm: directory non accessibile: %s\n' "${1:-.}" >&2
    exit 1
fi

# Manteniamo aperto /dev/tty: input e output rimangono affidabili anche in pipe.
exec 9<>/dev/tty
original_tty=$(stty -g <&9) || exit 1
alt_screen=1
[[ ${ABFM_NO_ALT_SCREEN:-0} == 1 ]] && alt_screen=0
mouse_enabled=0
declare -a entries=() clipboard=() targets=()
declare -A marks=()
declare -a action_keys=() action_starts=() action_ends=()
clipboard_mode=''
notice='Lynx: Su/Giu scegli, Destra apre, Sinistra torna. q esce.'
cursor=0
scroll=0
rows=24 cols=80 visible=12 inner=78
items_y=4
actions_y=0
last_click_ms=0
last_click_path=''
MOUSE_BTN=0; MOUSE_X=0; MOUSE_Y=0; MOUSE_ACTION=''
# Coordinate di rendering: righe salvate per evitare redraw completi.
needs_full=1
painted_rows=0 painted_cols=0 painted_scroll=-1 painted_cursor=-1
painted_notice=''
USE_COLOR=1; USE_UNICODE=1
CLR_RESET='' CLR_BORDER='' CLR_TITLE='' CLR_STATUS='' CLR_NOTICE='' CLR_CURSOR='' CLR_ACTION=''
CLR_PANEL='' CLR_DIR='' CLR_EXEC='' CLR_LINK='' CLR_BADLINK=''
CLR_MARKED='' CLR_MARK_CURSOR='' CLR_FOOTER='' CLR_HOTKEY=''
C_TL='+' C_TR='+' C_BL='+' C_BR='+' C_H='-' C_V='|' C_LT='+' C_RT='+'
init_theme() {
    local locale=${LC_ALL:-${LC_CTYPE:-${LANG:-}}}
    USE_COLOR=1; USE_UNICODE=1
    [[ -n ${NO_COLOR:-} || ${ABFM_NO_COLOR:-0} == 1 || ${TERM:-} == dumb ]] && USE_COLOR=0
    [[ ${ABFM_ASCII:-0} == 1 ]] && USE_UNICODE=0
    [[ $locale != *UTF-8* && $locale != *utf8* && $locale != *utf-8* ]] && USE_UNICODE=0
    # Palette neutra grigia con colori per tipo file, ANSI 256 colori.
    if (( USE_COLOR )); then
        CLR_RESET=$'\033[0m'
        # Tema grigio neutro: pannello grafite, evidenziazione chiara.
        CLR_PANEL=$'\033[38;5;252;48;5;240m'
        CLR_BORDER=$'\033[38;5;252;48;5;240m'
        CLR_TITLE=$'\033[1;38;5;255;48;5;240m'
        CLR_DIR=$'\033[1;38;5;255;48;5;240m'
        CLR_EXEC=$'\033[38;5;120;48;5;240m'
        CLR_LINK=$'\033[38;5;117;48;5;240m'
        CLR_BADLINK=$'\033[38;5;210;48;5;240m'
        CLR_MARKED=$'\033[1;38;5;228;48;5;240m'
        CLR_CURSOR=$'\033[38;5;232;48;5;250m'
        CLR_MARK_CURSOR=$'\033[1;38;5;130;48;5;250m'
        CLR_STATUS=$'\033[38;5;236;48;5;250m'
        CLR_NOTICE=$'\033[38;5;255;48;5;240m'
        CLR_FOOTER=$'\033[38;5;254;48;5;236m'
        CLR_HOTKEY=$'\033[38;5;232;48;5;250m'
    fi

    if (( USE_UNICODE )); then
        C_TL='┌'; C_TR='┐'; C_BL='└'; C_BR='┘'; C_H='─'; C_V='│'; C_LT='├'; C_RT='┤'
    fi
}
cleanup() {
    trap - EXIT INT TERM HUP WINCH
    stty "$original_tty" <&9 2>/dev/null || :
    if (( mouse_enabled )); then
        printf '\033[?1000l\033[?1006l' >&9
    fi
    printf '%s\033[?25h' "$CLR_RESET" >&9
    (( alt_screen )) && printf '\033[?1049l' >&9
    exec 9>&-
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
trap 'exit 129' HUP
trap ':' WINCH
stty -echo -icanon -icrnl min 1 time 0 <&9 || exit 1
init_theme
(( alt_screen )) && printf '\033[?1049h' >&9
printf '\033[?25l' >&9
printf '\033[?1000h\033[?1006h' >&9
mouse_enabled=1
shopt -s nullglob dotglob

safe() {
    local value=$1
    value=${value//[$'\001'-$'\037'$'\177']/\?}
    REPLY=$value
}

fit() {
    safe "$1"
    local str=$REPLY max=$2
    if (( ${#str} > max )); then
        if (( max > 3 )); then
            REPLY="${str:0:max-3}..."
        else
            REPLY="${str:0:max}"
        fi
    else
        REPLY=$str
    fi
}

line_text() {
    local s=$1 style=${2:-}
    fit "$s" "$inner"
    printf '%s%s%s' "$CLR_BORDER" "$C_V" "${style:-$CLR_PANEL}" >&9
    printf '%-*s' "$inner" "$REPLY" >&9
    printf '%s%s%s\r\n' "$CLR_BORDER" "$C_V" "$CLR_RESET" >&9
}
border() {
    local kind=${1:-mid} left right d
    printf -v d '%*s' "$inner" ''
    d=${d// /$C_H}
    case $kind in
        top) left=$C_TL; right=$C_TR ;;
        bottom) left=$C_BL; right=$C_BR ;;
        *) left=$C_LT; right=$C_RT ;;
    esac
    if [[ $kind == bottom ]]; then
        # Niente CRLF dalla cella finale: evita scroll e disallineamenti SGR.
        printf '%s%s%s%s%s' "$CLR_BORDER" "$left" "$d" "$right" "$CLR_RESET" >&9
    else
        printf '%s%s%s%s%s\r\n' "$CLR_BORDER" "$left" "$d" "$right" "$CLR_RESET" >&9
    fi
}

size() {
    local dimensions
    dimensions=$(stty size <&9 2>/dev/null) || dimensions='24 80'
    read -r rows cols <<< "$dimensions"
    [[ $rows =~ ^[0-9]+$ && $cols =~ ^[0-9]+$ ]] || { rows=24; cols=80; }
    inner=$((cols-2))
    visible=$((rows-8))
}

now_millis() {
    # EPOCHREALTIME segue LC_NUMERIC: in italiano puo' usare la virgola!
    # Non interpretare la stringa originale come intero Bash (bug riga 194).
    local stamp=${EPOCHREALTIME:-} sec frac
    stamp=${stamp/,/.}
    if [[ $stamp =~ ^([0-9]+)\.([0-9]{1,6})$ ]]; then
        sec=${BASH_REMATCH[1]}
        frac=${BASH_REMATCH[2]}
        frac=${frac:0:3}
        while (( ${#frac} < 3 )); do frac+="0"; done
        printf '%s\n' "$((10#$sec * 1000 + 10#$frac))"
    else
        # Bash < 5 o orologio non disponibile: secondi dal printf builtin.
        printf -v sec '%(%s)T' -1
        printf '%s\n' "$((10#$sec * 1000))"
    fi
}

reload() {
    local path
    local -a dirs=() files=()
    entries=('..')
    for path in "$cwd"/*; do
        [[ -d $path ]] && dirs+=("$path") || files+=("$path")
    done
    entries+=("${dirs[@]}" "${files[@]}")
    (( cursor >= ${#entries[@]} )) && cursor=$((${#entries[@]}-1))
    (( cursor < 0 )) && cursor=0
    (( scroll > cursor )) && scroll=$cursor
    # I segni di selezione sono locali alla directory visualizzata.
    marks=()
    needs_full=1
}

sync_scroll() {
    (( cursor < scroll )) && scroll=$cursor
    (( cursor >= scroll+visible )) && scroll=$((cursor-visible+1))
    (( scroll < 0 )) && scroll=0
}

render_actions() {
    local -a segs=(
        '[F3] Selez.' '[F4] Copia' '[F5] Taglia' '[F6] Incolla' '[F7] CreaDir' '[F8] Elimina'
    )
    # Barra MC: tasti evidenziati su ciano, comandi su fondo nero.
    if (( inner < 89 )); then
        segs=('3Sel' '4Cop' '5Tag' '6Inc' '7Dir' '8Del')
    fi
    action_keys=(F3 F4 F5 F6 F7 F8)
    action_starts=()
    action_ends=()
    local seg idx used=1 prefix suffix start width
    printf '%s%s%s ' "$CLR_BORDER" "$C_V" "$CLR_FOOTER" >&9
    for idx in "${!segs[@]}"; do
        seg=${segs[idx]}
        if (( idx > 0 )); then
            printf '  ' >&9
            ((used+=2))
        fi
        start=$((used + 2))
        if [[ $seg == \[* ]]; then
            prefix=${seg%%]*}']'
            suffix=${seg#"$prefix"}
        else
            prefix=${seg:0:1}
            suffix=${seg:1}
        fi
        printf '%s%s%s%s' "$CLR_HOTKEY" "$prefix" "$CLR_FOOTER" "$suffix" >&9
        ((used+=${#seg}))
        action_starts[idx]=$start
        action_ends[idx]=$((used+1))
    done
    width=$((inner-used))
    ((width > 0)) && printf '%*s' "$width" '' >&9
    printf '%s%s%s\r\n' "$CLR_BORDER" "$C_V" "$CLR_RESET" >&9
}

# Stampa la riga visibile nella posizione reale del terminale (1-based).
# Y=4 e' la prima riga, dopo cornice, titolo e separatore.
paint_entry() {
    local idx=$1 n item label selected kind row_style
    (( idx >= scroll && idx < scroll+visible )) || return 0
    n=$((idx-scroll))
    printf '\033[%d;1H' "$((items_y+n))" >&9
    if (( idx >= ${#entries[@]} )); then
        line_text ''
        return
    fi
    item=${entries[idx]}
    selected=' '
    [[ -v marks["$item"] ]] && selected='*'
    row_style=$CLR_PANEL
    kind=' '
    label=${item##*/}
    if [[ $item == '..' ]]; then
        kind='/'; label='..'; row_style=$CLR_DIR
    elif [[ -L $item ]]; then
        kind='@'
        if [[ -e $item ]]; then row_style=$CLR_LINK; else row_style=$CLR_BADLINK; fi
    elif [[ -d $item ]]; then
        kind='/'; row_style=$CLR_DIR
    elif [[ -f $item && -x $item ]]; then
        kind='*'; row_style=$CLR_EXEC
    fi
    [[ -v marks["$item"] ]] && row_style=$CLR_MARKED
    if (( idx == cursor )); then
        row_style=$CLR_CURSOR
        [[ -v marks["$item"] ]] && row_style=$CLR_MARK_CURSOR
    fi
    line_text " $selected $kind$label" "$row_style"
}

draw() {
    local i
    size
    if (( rows < 12 || cols < 35 )); then
        printf '\033[H\033[2JTerminale troppo piccolo (minimo 35x12).\r\n' >&9
        needs_full=1
        painted_rows=$rows; painted_cols=$cols
        return
    fi
    sync_scroll
    items_y=4
    actions_y=$((visible+5))
    help_y=$((visible+6))
    notice_y=$((visible+7))

    if (( needs_full || rows != painted_rows || cols != painted_cols || scroll != painted_scroll )); then
        # Riscrive alle posizioni fisse senza pulire tutto lo schermo.
        # Il bordo inferiore non emette CRLF, eliminando lo scroll terminale.
        printf '\033[H' >&9
        border top
        line_text " ai-bar-fm  $cwd" "$CLR_TITLE"
        border mid
        for ((i=0; i<visible; i++)); do
            paint_entry "$((scroll+i))"
        done
        printf '\033[%d;1H' "$((visible+4))" >&9
        border mid
        render_actions
        line_text ' Lynx: Su/Giu scegli, Destra entra, Sinistra torna. Mouse attivo; q Esci.' "$CLR_STATUS"
        line_text " $notice" "$CLR_NOTICE"
        border bottom
        needs_full=0
    else
        # In navigazione aggiorna solo la vecchia e la nuova riga.
        (( painted_cursor != cursor )) && paint_entry "$painted_cursor"
        paint_entry "$cursor"
        if [[ $painted_notice != "$notice" ]]; then
            printf '\033[%d;1H' "$notice_y" >&9
            line_text " $notice" "$CLR_NOTICE"
        fi
    fi
    painted_rows=$rows; painted_cols=$cols
    painted_scroll=$scroll; painted_cursor=$cursor
    painted_notice=$notice
}

input_key() {
    local char next code='' n payload
    KEY=''
    MOUSE_BTN=0; MOUSE_X=0; MOUSE_Y=0; MOUSE_ACTION=''
    IFS= read -rsn1 -u9 char || return 1
    case $char in
        $'\e')
            if ! IFS= read -rsn1 -t 0.10 -u9 next; then
                KEY='ESC'; return 0
            fi
            code=$next
            if [[ $next == '[' || $next == 'O' ]]; then
                for ((n=0; n<24; n++)); do
                    IFS= read -rsn1 -t 0.10 -u9 next || break
                    code+=$next
                    [[ $next == [a-zA-Z\~] ]] && break
                done
            fi
            if [[ $code == \[\<* ]]; then
                payload=${code#\[<}
                MOUSE_ACTION=${payload: -1}
                payload=${payload%?}
                IFS=';' read -r MOUSE_BTN MOUSE_X MOUSE_Y <<< "$payload"
                if [[ $MOUSE_BTN =~ ^[0-9]+$ && $MOUSE_X =~ ^[0-9]+$ && $MOUSE_Y =~ ^[0-9]+$ ]]; then
                    KEY='MOUSE'
                else
                    KEY='ESC'
                fi
                return 0
            fi
            case $code in
                '[A') KEY='UP';; '[B') KEY='DOWN';; '[C') KEY='RIGHT';; '[D') KEY='LEFT';; '[H'|'OH'|'[1~'|'[7~') KEY='HOME';;
                '[F'|'OF'|'[4~'|'[8~') KEY='END';;
                '[5~') KEY='PAGEUP';; '[6~') KEY='PAGEDOWN';;
                'OR'|'[13~'|'[[C') KEY='F3';;
                'OS'|'[14~'|'[[D') KEY='F4';;
                '[15~'|'[5^'|'[[E') KEY='F5';;
                '[17~'|'[[F') KEY='F6';;
                '[18~'|'[[G') KEY='F7';;
                '[19~'|'[[H') KEY='F8';;
                *) KEY='ESC';;
            esac
            ;;
        ''|$'\r'|$'\n') KEY='ENTER';;
        $'\177'|$'\b') KEY='BACK';;
        ' ') KEY='F3';;
        $'\030')
            # Sequenza MC: Ctrl+X poi C, O o S.
            IFS= read -rsn1 -u9 next || return 1
            case $next in
                c|C) KEY='CHMOD';;
                o|O) KEY='CHOWN';;
                s|S) KEY='SYMLINK';;
                *) KEY='BAD_CHORD';;
            esac
            ;;
        *) KEY=$char;;
    esac
}

# Inserimento in modalita' raw: niente dipendenze su read -e/readline o dialog.
ask() {
    local prompt=$1 value='' ch
    while :; do
        notice="$prompt$value"
        draw
        IFS= read -rsn1 -u9 ch || return 1
        case $ch in
            ''|$'\r'|$'\n') REPLY=$value; return 0;;
            $'\e')
                # Scarta sequenze mouse durante i prompt.
                local next tail k
                if IFS= read -rsn1 -t 0.08 -u9 next; then
                    if [[ $next == '[' ]]; then
                        IFS= read -rsn1 -t 0.08 -u9 tail || { notice='Operazione annullata.'; return 1; }
                        if [[ $tail == '<' ]]; then
                            for ((k=0; k<30; k++)); do
                                IFS= read -rsn1 -t 0.08 -u9 tail || break
                                [[ $tail == M || $tail == m ]] && break
                            done
                            continue
                        fi
                    fi
                fi
                notice='Operazione annullata.'
                return 1
                ;;
            $'\177'|$'\b') value=${value%?};;
            *)
                if [[ $ch == [[:print:]] && ${#value} -lt 200 ]]; then
                    value+=$ch
                fi
                ;;
        esac
    done
}

select_current() {
    local path=${entries[cursor]}
    if [[ $path == '..' ]]; then
        notice="La directory padre non e' selezionabile."
        return
    fi
    if [[ -v marks["$path"] ]]; then
        unset 'marks[$path]'
        notice='Elemento deselezionato.'
    else
        marks["$path"]=1
        notice='Elemento selezionato (*).'
    fi
}

collect() {
    local path
    targets=()
    for path in "${entries[@]}"; do
        [[ $path == '..' ]] && continue
        [[ -v marks["$path"] ]] && targets+=("$path")
    done
    if (( ${#targets[@]} == 0 )); then
        path=${entries[cursor]}
        [[ $path != '..' ]] && targets+=("$path")
    fi
}

save_clipboard() {
    local mode=$1
    collect
    if (( ${#targets[@]} == 0 )); then
        notice='Seleziona prima un elemento.'
        return
    fi
    clipboard=("${targets[@]}")
    clipboard_mode=$mode
    marks=()
    needs_full=1
    if [[ $mode == copy ]]; then
        notice="${#clipboard[@]} elemento/i copiati negli appunti (F6 per incollare)."
    else
        notice="${#clipboard[@]} elemento/i tagliati (F6 per spostare)."
    fi
}

paste() {
    local src dst okay=0 failed=0
    local -a remaining=()
    if (( ${#clipboard[@]} == 0 )); then
        notice='Gli appunti sono vuoti (usa F4 o F5).'
        return
    fi
    for src in "${clipboard[@]}"; do
        dst="$cwd/${src##*/}"
        if [[ ! -e $src && ! -L $src ]]; then
            ((failed+=1)); remaining+=("$src"); continue
        fi
        if [[ -e $dst || -L $dst ]]; then
            ((failed+=1)); remaining+=("$src"); continue
        fi
        # Non copiare o spostare una directory al proprio interno.
        if [[ -d $src && ! -L $src && "$cwd/" == "$src/"* ]]; then
            ((failed+=1)); remaining+=("$src"); continue
        fi
        if [[ $clipboard_mode == copy ]]; then
            if cp -a -- "$src" "$dst" >/dev/null 2>&1; then
                ((okay+=1))
            else
                ((failed+=1)); remaining+=("$src")
            fi
        else
            if mv -- "$src" "$dst" >/dev/null 2>&1; then
                ((okay+=1))
            else
                ((failed+=1)); remaining+=("$src")
            fi
        fi
    done
    if [[ $clipboard_mode == cut ]]; then
        clipboard=("${remaining[@]}")
        (( ${#clipboard[@]} == 0 )) && clipboard_mode=''
    fi
    notice="Incollati/spostati: $okay. Non riusciti: $failed (nessuna sovrascrittura)."
    cursor=1
    reload
}

new_dir() {
    local name
    if ! ask 'Nome nuova directory (Esc annulla): '; then return; fi
    name=$REPLY
    if [[ -z $name || $name == '.' || $name == '..' || $name == */* ]]; then
        notice='Nome non valido.'
        return
    fi
    if [[ -e "$cwd/$name" || -L "$cwd/$name" ]]; then
        notice="Esiste gia' un elemento con quel nome."
        return
    fi
    if mkdir -- "$cwd/$name" 2>/dev/null; then
        notice="Directory creata: $name"
    else
        notice='Creazione non riuscita (permessi o nome non valido).'
    fi
    reload
}

delete_items() {
    local path yes count=0 errors=0
    collect
    if (( ${#targets[@]} == 0 )); then
        notice='Seleziona prima un elemento.'
        return
    fi
    if ! ask "Eliminare ${#targets[@]} elemento/i? s/N: "; then return; fi
    yes=$REPLY
    if [[ $yes != 's' && $yes != 'S' && $yes != 'y' && $yes != 'Y' ]]; then
        notice='Eliminazione annullata.'
        return
    fi
    for path in "${targets[@]}"; do
        if rm -rf -- "$path" 2>/dev/null; then
            ((count+=1))
        else
            ((errors+=1))
        fi
    done
    cursor=1
    reload
    notice="Eliminati: $count. Errori: $errors."
}

# Libera il terminale per eseguire un programma interattivo.
run_executable() {
    local path=${entries[cursor]} status
    if [[ $path == '..' || ! -f $path || ! -x $path ]]; then
        notice="Il file selezionato non e' un eseguibile."
        return
    fi
    printf '\033[?1000l\033[?1006l\033[?25h%s' "$CLR_RESET" >&9
    (( alt_screen )) && printf '\033[?1049l' >&9
    stty "$original_tty" <&9 || return
    printf '\r\nai-bar-fm: esecuzione di %s\r\n' "${path##*/}" >&9
    # Invocazione diretta senza eval e senza interpolare il nome.
    "$path" <&9 >&9 2>&9
    status=$?
    printf '\r\n[Uscita: %d] Premi Invio per tornare al file manager...' "$status" >&9
    IFS= read -r -u9 _unused || :
    stty -echo -icanon -icrnl min 1 time 0 <&9 || return
    (( alt_screen )) && printf '\033[?1049h' >&9
    printf '\033[?25l\033[?1000h\033[?1006h' >&9
    needs_full=1
    notice="Eseguito: ${path##*/} (codice $status)."
}

chmod_items() {
    local mode path changed=0 failed=0
    collect
    if (( ${#targets[@]} == 0 )); then notice='Nessun elemento selezionato.'; return; fi
    if ! ask "chmod su ${#targets[@]} elemento/i (es. 755; Esc annulla): "; then return; fi
    mode=$REPLY
    if [[ ! $mode =~ ^[0-7]{3,4}$ ]]; then
        notice='Permessi non validi: usare 3 o 4 cifre ottali (es. 644, 0755).'
        return
    fi
    for path in "${targets[@]}"; do
        # I link vengono saltati: chmod li seguirebbe e cambierebbe il target.
        if [[ -L $path ]]; then
            ((failed+=1))
        elif chmod -- "$mode" "$path" 2>/dev/null; then
            ((changed+=1))
        else
            ((failed+=1))
        fi
    done
    reload
    notice="chmod $mode: modificati $changed, non riusciti $failed."
}

chown_items() {
    local owner path changed=0 failed=0
    collect
    if (( ${#targets[@]} == 0 )); then notice='Nessun elemento selezionato.'; return; fi
    if ! ask "chown su ${#targets[@]} elemento/i (utente[:gruppo]; Esc annulla): "; then return; fi
    owner=$REPLY
    if [[ -z $owner || $owner == *[[:space:]]* || $owner == */* || $owner == ':' ]]; then
        notice='Proprietario/gruppo non valido.'
        return
    fi
    for path in "${targets[@]}"; do
        if chown -- "$owner" "$path" 2>/dev/null; then
            ((changed+=1))
        else
            ((failed+=1))
        fi
    done
    reload
    notice="chown $owner: modificati $changed, non riusciti $failed (verifica permessi)."
}

create_symlink() {
    local path=${entries[cursor]} name
    if [[ $path == '..' ]]; then
        notice='Seleziona un file o una directory per il link.'
        return
    fi
    if ! ask "Nome del link simbolico a ${path##*/} (Esc annulla): "; then return; fi
    name=$REPLY
    if [[ -z $name || $name == '.' || $name == '..' || $name == */* ]]; then
        notice='Nome del link non valido (una sola componente).'
        return
    fi
    if [[ -e $cwd/$name || -L $cwd/$name ]]; then
        notice="Esiste gia' un file o link con questo nome."
        return
    fi
    # Link relativo alla directory: punta al nome originale.
    if ln -s -- "${path##*/}" "$cwd/$name" 2>/dev/null; then
        reload
        notice="Creato link $name -> ${path##*/}"
    else
        notice='Creazione link non riuscita (permessi?).'
    fi
}

enter_dir() {
    local path=${entries[cursor]}
    if [[ $path == '..' ]]; then
        cwd=$(cd -P -- "$cwd/.." && pwd -P)
    elif [[ -d $path ]]; then
        if ! cwd=$(cd -P -- "$path" 2>/dev/null && pwd -P); then
            notice='Impossibile entrare nella directory.'
            return
        fi
    elif [[ -f $path && -x $path ]]; then
        run_executable
        return
    else
        notice="Non e' una directory o un file eseguibile."
        return
    fi
    cursor=1; scroll=0
    reload
    notice="Directory: $cwd"
}

handle_mouse() {
    local idx i x y now path relx
    x=$MOUSE_X
    y=$MOUSE_Y
    if (( MOUSE_BTN == 64 )); then
        ((cursor > 0)) && ((cursor-=1))
        notice='Rotella su.'
        return
    fi
    if (( MOUSE_BTN == 65 )); then
        ((cursor + 1 < ${#entries[@]})) && ((cursor+=1))
        notice='Rotella giu.'
        return
    fi
    [[ $MOUSE_ACTION != M ]] && return
    (( MOUSE_BTN != 0 )) && return
    if (( x > 1 && x < cols && y >= items_y && y < items_y + visible )); then
        idx=$((scroll + y - items_y))
        if (( idx >= 0 && idx < ${#entries[@]} )); then
            cursor=$idx
            # La colonna 3 contiene il simbolo di marcatura (*).
            if (( x == 3 )) && [[ ${entries[idx]} != '..' ]]; then
                select_current
                return
            fi
            path=${entries[idx]}
            now=$(now_millis)
            if [[ $path == "$last_click_path" ]] && (( now - last_click_ms < 450 )); then
                last_click_ms=0
                last_click_path=''
                enter_dir
                return
            fi
            last_click_ms=$now
            last_click_path=$path
            notice='Riga selezionata con mouse.'
        fi
        return
    fi
    if (( y == actions_y )); then
        for i in "${!action_keys[@]}"; do
            if (( x >= action_starts[i] && x <= action_ends[i] )); then
                KEY=${action_keys[i]}
                return
            fi
        done
    fi
}

perform_key() {
    case $1 in
        UP|k) ((cursor>0)) && ((cursor-=1));;
        DOWN|j) ((cursor+1<${#entries[@]})) && ((cursor+=1));;
        PAGEUP) ((cursor-=visible)); ((cursor<0)) && cursor=0;;
        PAGEDOWN) ((cursor+=visible)); ((cursor>=${#entries[@]})) && cursor=$((${#entries[@]}-1));;
        HOME) cursor=0;;
        END) cursor=$((${#entries[@]}-1));;
        ENTER|RIGHT|l) enter_dir;;
        LEFT|h|BACK) cwd=$(cd -P -- "$cwd/.." && pwd -P); cursor=1; scroll=0; reload;;
        F3) select_current;;
        F4) save_clipboard copy;;
        F5) save_clipboard cut;;
        F6) paste;;
        F7) new_dir;;
        F8) delete_items;;
        CHMOD) chmod_items;;
        CHOWN) chown_items;;
        SYMLINK) create_symlink;;
        BAD_CHORD) notice='Ctrl+X: usare C per chmod, O per chown, S per link.';;
        r|R) reload; notice='Elenco aggiornato.';;
        ESC) notice='Premi q per uscire.';;
        q|Q) return 1;;
        *) ;;
    esac
    return 0
}

reload
(( ${#entries[@]} > 1 )) && cursor=1
while :; do
    draw
    if ! input_key; then break; fi
    if (( rows < 12 || cols < 35 )); then
        [[ $KEY == q || $KEY == Q ]] && break
        continue
    fi
    if [[ $KEY == MOUSE ]]; then
        KEY=''
        handle_mouse
        [[ -n $KEY ]] && perform_key "$KEY" || true
        continue
    fi
    if ! perform_key "$KEY"; then
        break
    fi
done
